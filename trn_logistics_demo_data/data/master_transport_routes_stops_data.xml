<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ========================================== -->
    <!-- 1. Transit Stop Address Locations           -->
    <!-- ========================================== -->
    <record id="partner_loc_clifton_hq" model="res.partner">
        <field name="name">Clifton HQ Executive Gate</field>
        <field name="street">Block 5, Clifton</field>
        <field name="city">Karachi</field>
        <field name="country_id" ref="base.pk"/>
        <field name="partner_latitude">24.8138</field>
        <field name="partner_longitude">67.0305</field>
        <field name="company_id" ref="company_paklink"/>
    </record>

    <record id="partner_loc_defence_ph2" model="res.partner">
        <field name="name">Defence Phase 2 Interchange</field>
        <field name="street">Sunset Boulevard, DHA Phase 2</field>
        <field name="city">Karachi</field>
        <field name="country_id" ref="base.pk"/>
        <field name="partner_latitude">24.8387</field>
        <field name="partner_longitude">67.0673</field>
        <field name="company_id" ref="company_paklink"/>
    </record>

    <record id="partner_loc_korangi_crossing" model="res.partner">
        <field name="name">Korangi Crossing Station</field>
        <field name="street">Main Korangi Road</field>
        <field name="city">Karachi</field>
        <field name="country_id" ref="base.pk"/>
