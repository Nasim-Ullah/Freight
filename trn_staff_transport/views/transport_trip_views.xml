<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip List View -->
    <record id="view_logistics_transport_trip_tree" model="ir.ui.view">
        <field name="name">logistics.transport.trip.list</field>
        <field name="model">logistics.transport.trip</field>
        <field name="arch" type="xml">
            <list string="Trips"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-primary="state == 'planned'"
                  decoration-warning="state == 'in_progress'"
                  decoration-success="state == 'completed'">
                <field name="name" string="Name"/>
                <field name="date" string="Date"/>
                <field name="route_id"/>
                <field name="direction"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="planned_departure_time"/>
                <field name="passenger_count" string="Passengers"/>
                <field name="capacity" string="Capacity"/>
                <field name="free_seats" string="Available Seats"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'planned'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Trip Form View -->
    <record id="view_logistics_transport_trip_form" model="ir.ui.view">
        <field name="name">logistics.transport.trip.form</field>
        <field name="model">logistics.transport.trip</field>
        <field name="arch" type="xml">
            <form string="Transport Trip">
                <header>
                    <button name="action_plan"
                            string="Plan"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_start"
                            string="Start Trip"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_complete"
                            string="Complete Trip"
                            type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('completed', 'cancelled')"/>
                    <button name="action_open_google_maps"
                            string="Open Google Maps"
                            type="object"
                            class="btn-primary"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,planned,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <widget name="web_ribbon"
                            title="Over Capacity"
                            bg_color="text-bg-danger"
                            invisible="not is_over_capacity"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="route_id"/>
                            <field name="schedule_id"/>
                            <field name="direction"/>
                        </group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="driver_id" domain="[('is_driver', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" context="{'default_is_driver': True, 'default_is_company': False}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="True"/>
                        </group>
                    </group>

                    <group string="Trip Timings">
                        <group>
                            <field name="planned_departure_time"/>
                            <field name="actual_departure_datetime"/>
                        </group>
                        <group>
                            <field name="planned_arrival_time"/>
                            <field name="actual_arrival_datetime"/>
                        </group>
                    </group>
                    <group string="Capacity">
                        <field name="passenger_count"/>
                        <field name="capacity"/>
                        <field name="free_seats"/>
                        <field name="occupancy_rate" widget="progressbar"/>
                    </group>

                    <notebook>
                        <page string="Passengers" name="page_passengers">
                            <field name="passenger_ids">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="pickup_stop_id"/>
                                    <field name="dropoff_stop_id"/>
                                    <field name="status"
                                           widget="badge"
                                           decoration-info="status == 'expected'"
                                           decoration-primary="status == 'boarded'"
                                           decoration-danger="status == 'no_show'"
                                           decoration-success="status == 'dropped'"
                                           decoration-muted="status == 'cancelled'"/>
                                    <field name="boarding_time" optional="hide"/>
                                    <field name="drop_time" optional="hide"/>
                                    <button name="action_board"
                                            string="Board"
                                            type="object"
                                            icon="fa-sign-in"
                                            class="btn-outline-primary btn-sm"
                                            invisible="status in ('boarded', 'dropped', 'cancelled')"/>
                                    <button name="action_drop"
                                            string="Drop"
                                            type="object"
                                            icon="fa-sign-out"
                                            class="btn-outline-success btn-sm"
                                            invisible="status != 'boarded'"/>
                                    <button name="action_no_show"
                                            string="No Show"
                                            type="object"
                                            icon="fa-user-times"
                                            class="btn-outline-danger btn-sm"
                                            invisible="status != 'expected'"/>
                                    <button name="action_reset"
                                            string="Reset"
                                            type="object"
                                            icon="fa-undo"
                                            class="btn-outline-secondary btn-sm"
                                            invisible="status == 'expected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="page_notes">
                            <field name="notes" placeholder="Trip logs, delay reasons, driver handover notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Trip Search View -->
    <record id="view_logistics_transport_trip_search" model="ir.ui.view">
        <field name="name">logistics.transport.trip.search</field>
        <field name="model">logistics.transport.trip</field>
        <field name="arch" type="xml">
            <search string="Search Trips">
                <field name="name"/>
                <field name="route_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today())]"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Over Capacity" name="filter_over_capacity" domain="[('is_over_capacity', '=', True)]"/>
                <group>
                    <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Trip Action -->
    <record id="action_logistics_transport_trip" model="ir.actions.act_window">
        <field name="name">Trips</field>
        <field name="res_model">logistics.transport.trip</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_transport_trip_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transport trips found. Generate trips using the wizard or create a new trip manually.
            </p>
        </field>
    </record>

    <!-- Passenger List View -->
    <record id="view_logistics_transport_trip_passenger_tree" model="ir.ui.view">
        <field name="name">logistics.transport.trip.passenger.list</field>
        <field name="model">logistics.transport.trip.passenger</field>
        <field name="arch" type="xml">
            <list string="Passengers">
                <field name="trip_id"/>
                <field name="employee_id"/>
                <field name="pickup_stop_id"/>
                <field name="dropoff_stop_id"/>
                <field name="status"
                       widget="badge"
                       decoration-info="status == 'expected'"
                       decoration-primary="status == 'boarded'"
                       decoration-danger="status == 'no_show'"
                       decoration-success="status == 'dropped'"
                       decoration-muted="status == 'cancelled'"/>
                <field name="boarding_time"/>
                <field name="drop_time"/>
            </list>
        </field>
    </record>

    <!-- Passenger Form View -->
    <record id="view_logistics_transport_trip_passenger_form" model="ir.ui.view">
        <field name="name">logistics.transport.trip.passenger.form</field>
        <field name="model">logistics.transport.trip.passenger</field>
        <field name="arch" type="xml">
            <form string="Passenger">
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="pickup_stop_id"/>
                            <field name="sequence" readonly="True"/>
                            <field name="boarding_time"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="notes"/>
                        </group>
                        <group>
                            <field name="employee_id"/>
                            <field name="dropoff_stop_id"/>
                            <field name="status"/>
                            <field name="drop_time"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Passenger Search View -->
    <record id="view_logistics_transport_trip_passenger_search" model="ir.ui.view">
        <field name="name">logistics.transport.trip.passenger.search</field>
        <field name="model">logistics.transport.trip.passenger</field>
        <field name="arch" type="xml">
            <search string="Search Passengers">
                <field name="employee_id"/>
                <field name="trip_id"/>
                <field name="pickup_stop_id"/>
                <field name="dropoff_stop_id"/>
                <separator/>
                <filter string="Expected" name="filter_expected" domain="[('status', '=', 'expected')]"/>
                <filter string="Boarded" name="filter_boarded" domain="[('status', '=', 'boarded')]"/>
                <filter string="Dropped" name="filter_dropped" domain="[('status', '=', 'dropped')]"/>
                <filter string="No Show" name="filter_no_show" domain="[('status', '=', 'no_show')]"/>
                <group>
                    <filter string="Trip" name="group_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Pickup Stop" name="group_pickup" context="{'group_by': 'pickup_stop_id'}"/>
                    <filter string="Drop-off Stop" name="group_dropoff" context="{'group_by': 'dropoff_stop_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Passenger Action -->
    <record id="action_logistics_transport_trip_passenger" model="ir.actions.act_window">
        <field name="name">Passengers</field>
        <field name="res_model">logistics.transport.trip.passenger</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_transport_trip_passenger_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No passenger attendance records found.
            </p>
        </field>
    </record>
</odoo>
