<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Generate Trips Wizard Form View -->
    <record id="view_generate_trips_wizard_form" model="ir.ui.view">
        <field name="name">logistics.transport.generate.trips.wizard.form</field>
        <field name="model">logistics.transport.generate.trips.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Daily Transport Trips">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="route_ids" widget="many2many_tags" placeholder="All active routes..."/>
                            <field name="direction"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_trips"
                            string="Generate Trips"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_generate_trips_wizard" model="ir.actions.act_window">
        <field name="name">Generate Trips</field>
        <field name="res_model">logistics.transport.generate.trips.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_logistics_transport_trip"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Menuitem under Operations (placed after Trips) -->
    <menuitem id="menu_transport_generate_trips"
              name="Generate Trips"
              parent="menu_transport_operations"
              action="action_generate_trips_wizard"
              sequence="10"/>
</odoo>
