<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Schedule Tree / List View -->
    <record id="view_logistics_transport_schedule_tree" model="ir.ui.view">
        <field name="name">logistics.transport.schedule.list</field>
        <field name="model">logistics.transport.schedule</field>
        <field name="arch" type="xml">
            <list string="Transport Schedules">
                <field name="name"/>
                <field name="route_id"/>
                <field name="direction"/>
                <field name="departure_time" widget="float_time"/>
                <field name="arrival_time" widget="float_time"/>
                <field name="days_display"/>
                <field name="vehicle_id" optional="show"/>
                <field name="driver_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Schedule Form View -->
    <record id="view_logistics_transport_schedule_form" model="ir.ui.view">
        <field name="name">logistics.transport.schedule.form</field>
        <field name="model">logistics.transport.schedule</field>
        <field name="arch" type="xml">
            <form string="Transport Schedule">
                <sheet>
                    <field name="name" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="route_id"/>
                            <field name="direction"/>
                            <field name="active"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="departure_time" widget="float_time"/>
                            <field name="arrival_time" widget="float_time"/>
                            <field name="vehicle_id"/>
                            <field name="driver_id" domain="[('is_driver', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]" context="{'default_is_driver': True, 'default_is_company': False}"/>
                        </group>
                    </group>

                    <group string="OPERATING DAYS">
                        <group>
                            <field name="monday"/>
                            <field name="tuesday"/>
                            <field name="wednesday"/>
                            <field name="thursday"/>
                            <field name="friday"/>
                            <field name="saturday"/>
                            <field name="sunday"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Schedule Search View -->
    <record id="view_logistics_transport_schedule_search" model="ir.ui.view">
        <field name="name">logistics.transport.schedule.search</field>
        <field name="model">logistics.transport.schedule</field>
        <field name="arch" type="xml">
            <search string="Search Schedules">
                <field name="name"/>
                <field name="route_id"/>
                <filter string="Pickup" name="filter_pickup" domain="[('direction', '=', 'pickup')]"/>
                <filter string="Drop-off" name="filter_drop_off" domain="[('direction', '=', 'drop_off')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Route" name="group_route" context="{'group_by': 'route_id'}"/>
                    <filter string="Direction" name="group_direction" context="{'group_by': 'direction'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Schedule Action -->
    <record id="action_logistics_transport_schedule" model="ir.actions.act_window">
        <field name="name">Schedules</field>
        <field name="res_model">logistics.transport.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_transport_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create daily or weekly schedules for staff transport routes.
            </p>
        </field>
    </record>
</odoo>
