<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_transport" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.transport</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Trips smart button to button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_transport_routes"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bus"
                        help="Staff transport routes assigned to this vehicle">
                    <field name="trip_count" widget="statinfo" string="Trips"/>
                </button>
            </xpath>

            <!-- Add capacity override and effective capacity next to seats -->
            <xpath expr="//field[@name='seats']" position="after">
                <field name="seat_capacity_override"/>
                <field name="effective_capacity"/>
            </xpath>
        </field>
    </record>
</odoo>
