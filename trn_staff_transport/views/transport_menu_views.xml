    <menuitem id="menu_transport_stop"
              name="Stops"
              parent="menu_transport_planning"
              action="action_logistics_transport_stop"
              sequence="15"/>

    <!-- Drivers Menu -->
    <menuitem id="menu_transport_driver"
              name="Drivers"
              parent="menu_transport_planning"
              action="action_transport_driver"
              sequence="20"/>

    <!-- Reporting Category -->
    <menuitem id="menu_transport_reporting"
              name="Reporting"
              parent="menu_transport_root"
              sequence="30"/>

    <!-- Passengers Menu -->
    <menuitem id="menu_transport_reporting_passengers"
              name="Passengers"
              parent="menu_transport_reporting"
              action="action_logistics_transport_trip_passenger"
              sequence="10"/>
</odoo>
