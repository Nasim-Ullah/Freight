<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequence for Logistics Transport Trip -->
    <record id="seq_logistics_transport_trip" model="ir.sequence">
        <field name="name">Logistics Transport Trip</field>
        <field name="code">logistics.transport.trip</field>
        <field name="prefix">TRP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequence for Logistics Transport Vehicle Request -->
    <record id="seq_logistics_transport_vehicle_request" model="ir.sequence">
        <field name="name">Logistics Transport Vehicle Request</field>
        <field name="code">logistics.transport.vehicle.request</field>
        <field name="prefix">VRQ/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
