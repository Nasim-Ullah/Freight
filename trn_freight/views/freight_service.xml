<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Form view-->
    <record id="view_freight_service_form" model="ir.ui.view">
        <field name="name">freight.service.form</field>
        <field name="model">freight.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sale_price"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <notebook>
                            <page string="Vendor Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="vendor_id"/>
                                        <field name="sale_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--list view-->
    <record id="view_freight_service_list" model="ir.ui.view">
        <field name="name">freight.service.list</field>
        <field name="model">freight.service</field>
        <field name="arch" type="xml">
            <list string="Services">
                <field name="name"/>
                <field name="sale_price"/>
            </list>
        </field>
    </record>

    <!--Search View-->
    <record id="view_freight_service_search" model="ir.ui.view">
        <field name="name">freight.service.search</field>
        <field name="model">freight.service</field>
        <field name="arch" type="xml">
            <search string="Search Services">
                <field name="name" string="Service Name"/>

                <separator/>
                <field name="company_id" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <!--Action-->
    <record id="action_freight_service" model="ir.actions.act_window">
        <field name="name">Freight Services</field>
        <field name="res_model">freight.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menu-->
    <menuitem id="menu_freight_services" name="Services" parent="menu_freight_config" action="action_freight_service" sequence="50"/>
</odoo>