<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Form View-->
    <record id="view_freight_routes_form" model="ir.ui.view">
        <field name="name">freight.routes.form</field>
        <field name="model">freight.routes</field>
        <field name="arch" type="xml">
            <form string="Routes">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg_danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="land_price"/>
                            <field name="air_price"/>
                            <field name="water_price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--list view-->
    <record id="view_freight_routes_list" model="ir.ui.view">
        <field name="name">freight.routes.list</field>
        <field name="model">freight.routes</field>
        <field name="arch" type="xml">
            <list string="Routes">
                <field name="name"/>
                <field name="land_price"/>
                <field name="air_price"/>
                <field name="water_price"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!--Action-->
    <record id="action_freight_routes" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">freight.routes</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menu-->
    <menuitem id="menu_freight_routes" name="Routes" parent="menu_freight_config" action="action_freight_routes" sequence="40"/>
</odoo>