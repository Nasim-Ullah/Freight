<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Form view-->
    <record id="view_freight_shipping_form" model="ir.ui.view">
        <field name="name">freight_shipping_form</field>
        <field name="model">freight.shipping</field>
        <field name="arch" type="xml">
            <form string="Freight Order">
                <header>
                    <button name="action_custom_clearance" string="Custom Clearance" type="object"
                            class="btn-primary"/>

                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'submitted'"
                            class="btn-primary"/>
                    <button name="action_invoice" string="Invoice" type="object" invisible="state != 'confirmed'"
                            class="btn-primary"/>
                    <button name="action_tracking" string="Tracking" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Done" type="object"
                            invisible="state not in ('confirmed', 'invoiced')" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,confirmed,invoiced,done"/>
                </header>
                <sheet>
                    <!--Smart Buttons-->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_custom_clearance" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="clearance_count" widget="statinfo" string="Clearance"/>
                        </button>
                        <button name="action_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoice"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="shipper_id" required="1"/>
                            <field name="consignee_id"/>
                            <field name="order_date" required="1"/>
                            <field name="loading_port_id" required="1"/>
                            <field name="agent_id" required="1"/>
                        </group>
                        <group>
                            <field name="shipping_type" required="1"/>
                            <field name="transport" required="1"/>
                            <field name="land_type" invisible="transport != 'land'" required="transport == 'land'"/>
                            <field name="water_type" invisible="transport != 'water'" required="transport == 'water'"/>
                            <field name="discharge_port_id" required="1"/>
                            <field name="expected_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <!--Order-->
                        <page string="Order">
                            <field name="cargo_line_ids">
                                <list editable="bottom">
                                    <field name="container_id"/>
                                    <field name="product_id"/>
                                    <field name="billing_on"/>
                                    <field name="pricing"/>
                                    <field name="volume"/>
                                    <field name="weight"/>
                                    <field name="unit_price"/>
                                    <field name="total_price"/>
                                </list>
                            </field>
                            <!--footer-->
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_volume"/>
                                <field name="total_weight"/>
                                <field name="total" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <!--Routes-->
                        <page string="Routes">
                            <field name="route_line_ids">
                                <list editable="bottom">
                                    <field name="route_id"/>
                                    <field name="source_port_id"/>
                                    <field name="destination_port_id"/>
                                    <field name="transport"/>
                                    <field name="sale_price"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="routes_total" string="Total Sale" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>

                        <!--services-->
                        <page string="Services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="vendor_id"/>
                                    <field name="quantity"/>
                                    <field name="sale"/>
                                    <field name="total_sale"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="services_total" string="Service Total Sale"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <!--Tracking-->
                        <page string="Track">
                            <field name="track_line_ids">
                                <list editable="bottom">
                                    <field name="source_port_id"/>
                                    <field name="destination_port_id"/>
                                    <field name="transport"/>
                                    <field name="date"/>
                                    <field name="received_delivered"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!--List view-->
    <record id="view_freight_shipping_list" model="ir.ui.view">
        <field name="name">freight_shipping_list</field>
        <field name="model">freight.shipping</field>
        <field name="arch" type="xml">
            <list string="Freight Order">
                <field name="name" string="Name"/>
                <field name="shipping_type"/>
                <field name="transport"/>
                <field name="loading_port_id"/>
                <field name="discharge_port_id"/>
            </list>
        </field>
    </record>

    <!--
        <record id="view_freight_shipping_search" model="ir.ui.view">
            <field name="name">freight_shipping_search</field>
            <field name="model">freight.shipping</field>
            <field name="arch" type="xml">
                <search string="">

                </search>
            </field>
        </record>
    -->

    <!--Action-->
    <record id="action_freight_shipping" model="ir.actions.act_window">
        <field name="name">Freight Order</field>
        <field name="res_model">freight.shipping</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menu-->
    <menuitem id="menu_freight_shipping" name="Shipping" parent="menu_freight_root" action="action_freight_shipping"
              sequence="10"/>
    <menuitem id="menu_freight_config" name="Configuration" parent="menu_freight_root" sequence="100"/>
</odoo>