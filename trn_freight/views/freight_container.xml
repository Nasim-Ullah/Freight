<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form view -->
    <record id="view_freight_container_form" model="ir.ui.view">
        <field name="name">freight.container.form</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <form string="Containers">
                <sheet>
                    <!--<widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>-->
                    <header>
                        <field name="state" widget="statusbar" stausbar_visible="available,reserved"/>
                    </header>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="size"/>
                            <field name="weight"/>
                            <field name="volume"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="size_unit"/>
                            <field name="weight_unit"/>
                            <field name="volume_unit"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view -->
    <record id="view_freight_container_list" model="ir.ui.view">
        <field name="name">freight.container.list</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <list string="Containers">
                <field name="name"/>
                <field name="active" widget="boolean_toggle" class="text_center"/>
            </list>
        </field>
    </record>

    <!--search view-->
    <record id="view_freight_container_search" model="ir.ui.view">
        <field name="name">freight.container.search</field>
        <field name="model">freight.container</field>
        <field name="arch" type="xml">
            <search string="Search Containers">
                <field name="name" string="Container Name" filter_domain="['|'('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>

                <separator/>
                <filter string="Available" name="filter_available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserved" name="filter_reserved" domain="[('state', '=', 'reserved')]"/>
                <separator/>

                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="action_freight_container" model="ir.actions.act_window">
        <field name="name">Freight Container</field>
        <field name="res_model">freight.container</field>
        <field name="view_mode">list,form</field>
        <!--<field name="search_view_id" ref="view_freight_container_search"/>-->
    </record>

    <!-- menu -->
    <menuitem id="menu_freight_containers" name="Containers" parent="menu_freight_config" action="action_freight_container" sequence="20"/>

</odoo>