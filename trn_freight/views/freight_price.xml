<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Form View-->
    <record id="view_freight_price_form" model="ir.ui.view">
        <field name="name">freight.price.form</field>
        <field name="model">freight.price</field>
        <field name="arch" type="xml">
            <form string="Price">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <group>
                            <field name="weight_price"/>
                        </group>
                        <group>
                            <field name="volume_price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--List View-->
    <record id="view_freight_price_list" model="ir.ui.view">
        <field name="name">freight.price.list</field>
        <field name="model">freight.price</field>
        <field name="arch" type="xml">
            <list string="Price">
                <field name="name"/>
                <field name="volume_price"/>
                <field name="weight_price"/>
            </list>
        </field>
    </record>

    <!--Action-->
    <record id="action_freight_price" model="ir.actions.act_window">
        <field name="name">Freight price</field>
        <field name="res_model">freight.price</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--menu-->
    <menuitem id="menu_freight_pricing" name="Pricing" parent="menu_freight_config" action="action_freight_price" sequence="30"/>
</odoo>