<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_freight_tracking_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px; color: #333333;">
                        <!-- Inline CSS for Tracking Report -->
                        <style>
                            .tracking-title-box {
                                border-bottom: 2px solid #28a745;
                                padding-bottom: 8px;
                                margin-bottom: 16px;
                            }
                            .summary-card {
                                background-color: #f8f9fa;
                                border: 1px solid #e9ecef;
                                border-radius: 4px;
                                padding: 10px 14px;
                                margin-bottom: 18px;
                            }
                            .summary-card table td {
                                padding: 4px 6px;
                                border: none;
                            }
                            .summary-label {
                                font-weight: 600;
                                color: #495057;
                                width: 35%;
                            }
                            .section-heading {
                                font-size: 14px;
                                font-weight: 700;
                                color: #28a745;
                                margin-top: 18px;
                                margin-bottom: 8px;
                                text-transform: uppercase;
                                border-bottom: 1px solid #dee2e6;
                                padding-bottom: 4px;
                            }
                            table.tracking-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 20px;
                            }
                            table.tracking-table thead {
                                display: table-header-group; /* Repeat on multi-page */
                            }
                            table.tracking-table th {
                                background-color: #f1f3f5;
                                color: #212529;
                                font-weight: 600;
                                border: 1px solid #dee2e6;
                                padding: 8px 10px;
                                font-size: 12px;
                            }
                            table.tracking-table td {
                                border: 1px solid #e9ecef;
                                padding: 8px 10px;
                                vertical-align: middle;
                                font-size: 12px;
                            }
                            table.tracking-table tr {
                                page-break-inside: avoid; /* Prevent row cutting */
                            }
                            .badge-received {
                                background-color: #cce5ff;
                                color: #004085;
                                padding: 3px 8px;
                                border-radius: 3px;
                                font-weight: 600;
                                font-size: 11px;
                                text-transform: uppercase;
                            }
                            .badge-delivered {
                                background-color: #d4edda;
                                color: #155724;
                                padding: 3px 8px;
                                border-radius: 3px;
                                font-weight: 600;
                                font-size: 11px;
                                text-transform: uppercase;
                            }
                        </style>

                        <!-- Tracking Header Banner -->
                        <div class="row tracking-title-box align-items-center">
                            <div class="col-8">
                                <h3 style="margin: 0; font-weight: 700; color: #1a1a1a;">
                                    SHIPMENT TRACKING REPORT
                                </h3>
                                <div style="font-size: 13px; color: #6c757d; margin-top: 2px;">
                                    Freight Order Reference: <strong><span t-field="doc.name"/></strong>
                                </div>
                            </div>
                            <div class="col-4 text-end text-right">
                                <span style="font-size: 12px; color: #6c757d;">
                                    Current Status:
                                </span>
                                <strong style="text-transform: uppercase; font-size: 13px;">
                                    <span t-field="doc.state"/>
                                </strong>
                            </div>
                        </div>

                        <!-- Order Summary Card -->
                        <div class="summary-card">
                            <div class="row">
                                <div class="col-6">
                                    <table style="width: 100%;">
                                        <tr>
                                            <td class="summary-label">Shipper:</td>
                                            <td><strong t-field="doc.shipper_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Consignee:</td>
                                            <td><span t-field="doc.consignee_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Customs Agent:</td>
                                            <td><span t-field="doc.agent_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Operation:</td>
                                            <td><span t-field="doc.shipping_type"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table style="width: 100%;">
                                        <tr>
                                            <td class="summary-label">Loading Port:</td>
                                            <td><span t-field="doc.loading_port_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Discharge Port:</td>
                                            <td><span t-field="doc.discharge_port_id.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Transport Mode:</td>
                                            <td><span t-field="doc.transport"/></td>
                                        </tr>
                                        <tr>
                                            <td class="summary-label">Order Date:</td>
                                            <td><span t-field="doc.order_date" t-options='{"widget": "datetime"}'/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Complete Tracking Timeline Table -->
                        <div class="section-heading">Milestone Tracking Timeline</div>
                        <table class="tracking-table">
                            <thead>
                                <tr>
                                    <th style="width: 6%; text-align: center;">#</th>
                                    <th style="width: 22%;">Timestamp</th>
                                    <th style="width: 24%;">Source Location</th>
                                    <th style="width: 24%;">Destination Location</th>
                                    <th style="width: 12%; text-align: center;">Transport</th>
                                    <th style="width: 12%; text-align: center;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="track_idx" t-value="1"/>
                                <tr t-foreach="doc.track_line_ids" t-as="track">
                                    <td style="text-align: center;"><t t-esc="track_idx"/></td>
                                    <td><span t-field="track.date" t-options='{"widget": "datetime"}'/></td>
                                    <td><span t-field="track.source_port_id.name"/></td>
                                    <td><span t-field="track.destination_port_id.name"/></td>
                                    <td style="text-align: center; text-transform: capitalize;">
                                        <span t-field="track.transport"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span t-attf-class="#{ 'badge-delivered' if track.received_delivered == 'delivered' else 'badge-received' }">
                                            <span t-field="track.received_delivered"/>
                                        </span>
                                    </td>
                                    <t t-set="track_idx" t-value="track_idx + 1"/>
                                </tr>
                                <tr t-if="not doc.track_line_ids">
                                    <td colspan="6" class="text-center text-muted" style="text-align: center; font-style: italic; padding: 16px;">
                                        No tracking milestones recorded for this shipment yet.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
